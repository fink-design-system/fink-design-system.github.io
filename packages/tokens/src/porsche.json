{
  "$description": "Stil-Nachbau des Porsche Design System v4 (Quelle: designsystem.porsche.com/v4/tokens). Die Schrift Porsche Next ist lizenziert und wird durch Inter ersetzt; Original-Schriftdateien werden nicht eingebettet.",
  "color": {
    "primary": { "light": "hsl(225 66.7% 1.2%)", "dark": "hsl(225 100% 99%)", "$description": "colorPrimary – Porsche arbeitet bewusst monochrom" },
    "primary-variant": { "light": "hsl(240 8.7% 9% / 0.8)", "dark": "hsl(240 12.5% 96.9% / 0.78)", "$description": "colorContrastHigher als Hover-/Aktiv-Betonung" },
    "secondary": { "light": "hsl(240 10% 95%)", "dark": "hsl(240 2% 10%)", "$description": "colorSurface als getönte Fläche" },
    "success": { "light": "hsl(115 77.5% 27.8%)", "dark": "hsl(157 84.9% 41.6%)", "$description": "colorSuccess" },
    "warning": { "light": "hsl(28 97.7% 34.1%)", "dark": "hsl(28 90.2% 56.1%)", "$description": "colorWarning" },
    "danger": { "light": "hsl(357 78% 41%)", "dark": "hsl(0 96.9% 62%)", "$description": "colorError" },
    "info": { "light": "hsl(228 83.2% 51%)", "dark": "hsl(210 100% 54.5%)", "$description": "colorInfo" },
    "text": { "light": "hsl(225 66.7% 1.2%)", "dark": "hsl(225 100% 99%)", "$description": "colorPrimary ist zugleich die Textfarbe" },
    "subtle": { "light": "hsl(240 6.1% 7% / 0.6)", "dark": "hsl(240 12.5% 96.9% / 0.56)", "$description": "colorContrastMedium" },
    "ink": { "light": "#000000", "dark": "hsl(225 100% 99%)", "$description": "Höchster Kontrast" },
    "surface": { "light": "#ffffff", "dark": "hsl(225 66.7% 1.2%)", "$description": "colorCanvas" },
    "light": { "light": "#ffffff", "dark": "hsl(225 66.7% 1.2%)", "$description": "Porsche kennt keine Flächenebenen, Canvas überall" },
    "overlay": { "light": "#ffffff", "dark": "hsl(225 66.7% 1.2%)", "$description": "Dialoge auf Canvas" },
    "mute": { "light": "hsl(240 10% 95%)", "dark": "hsl(240 2% 10%)", "$description": "colorSurface" },
    "mute-variant": { "light": "hsl(240 5.3% 14.9% / 0.5)", "dark": "hsl(240 12.5% 96.9% / 0.45)", "$description": "colorContrastLow als Linienfarbe" },
    "edge": { "light": "transparent", "dark": "hsl(240 12.5% 96.9% / 0.45)", "$description": "Kante statt Schatten im Dark Mode" },
    "visited": { "light": "hsl(225 66.7% 1.2%)", "dark": "hsl(225 100% 99%)", "$description": "Porsche dokumentiert keine Visited-Farbe; Links bleiben Primary" },
    "shadow": { "light": "rgb(0 0 0 / 0.16)", "dark": "transparent", "$description": "aus shadowSm/Md/Lg (rgba(0,0,0,.16))" },
    "backdrop": { "light": "hsl(240 5.3% 14.9% / 0.5)", "dark": "hsl(240 5.3% 14.9% / 0.5)", "$description": "colorBackdrop" }
  },
  "focus": {
    "color": { "value": "#1A44EA", "$description": "colorFocus – dokumentierte Fokusfarbe, unabhängig von der monochromen Primärfarbe" }
  },
  "font": {
    "weight-regular": { "value": "400" },
    "weight-medium": { "value": "600", "$description": "fontWeightSemibold; Porsche Next wird durch Inter ersetzt" },
    "weight-bold": { "value": "700" }
  },
  "type-scale": {
    "xs": { "value": "0.75rem", "$description": "typescale2Xs" },
    "sm": { "value": "0.875rem", "$description": "typescaleXs" },
    "md": { "value": "1rem", "$description": "typescaleSm" },
    "lg": { "value": "clamp(1.13rem, 0.21vw + 1.08rem, 1.33rem)", "$description": "typescaleMd, fluid" },
    "xl": { "value": "clamp(1.27rem, 0.51vw + 1.16rem, 1.78rem)", "$description": "typescaleLg, fluid" },
    "2xl": { "value": "clamp(1.42rem, 0.94vw + 1.23rem, 2.37rem)", "$description": "typescaleXl, fluid" },
    "3xl": { "value": "clamp(1.6rem, 1.56vw + 1.29rem, 3.16rem)", "$description": "typescale2Xl, fluid" }
  },
  "space": {
    "1": { "value": "0.25rem", "$description": "spacingStaticXs" },
    "2": { "value": "0.5rem", "$description": "spacingStaticSm" },
    "3": { "value": "0.75rem", "$description": "Zwischenstufe des 4-px-Rasters, Porsche definiert nur 4/8/16/32/48/80" },
    "4": { "value": "1rem", "$description": "spacingStaticMd" },
    "5": { "value": "2rem", "$description": "spacingStaticLg" },
    "6": { "value": "3rem", "$description": "spacingStaticXl" },
    "7": { "value": "4rem", "$description": "Zwischenstufe zwischen Xl und 2Xl" },
    "8": { "value": "5rem", "$description": "spacingStatic2Xl" }
  },
  "radius": {
    "sm": { "value": "4px", "$description": "radiusSm" },
    "md": { "value": "12px", "$description": "radiusXl – interaktive Elemente im primären Look" },
    "lg": { "value": "24px", "$description": "radius3Xl – Card- und Dialog-Container" },
    "pill": { "value": "calc(infinity * 1px)", "$description": "radiusFull – Tag und Switch" }
  },
  "elevation": {
    "1": { "value": "0 3px 8px var(--fink-color-shadow)", "$description": "shadowSm" },
    "2": { "value": "0 4px 16px var(--fink-color-shadow)", "$description": "shadowMd" },
    "3": { "value": "0 8px 40px var(--fink-color-shadow)", "$description": "shadowLg" }
  },
  "motion": {
    "duration-fast": { "value": "250ms", "$description": "durationSm" },
    "duration-base": { "value": "400ms", "$description": "durationMd" },
    "easing": { "value": "cubic-bezier(0, 0, 0.2, 1)", "$description": "easeIn" }
  }
}
