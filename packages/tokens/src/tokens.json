{
  "$description": "Fink Design Tokens. Farbwerte mit light/dark werden zu light-dark() aufgelöst. Die Anwendung steuert das Schema über color-scheme.",
  "color": {
    "primary": { "light": "#3b2fc9", "dark": "#b7b0ff", "$description": "Markenfarbe, Primäraktionen, Fokus" },
    "primary-variant": { "light": "#2a1f9e", "dark": "#d6d2ff", "$description": "Hover/aktiv der Markenfarbe" },
    "secondary": { "light": "#e9e7ff", "dark": "#2a2659", "$description": "Getönte Fläche zur Markenfarbe" },
    "success": { "light": "#0b6b4f", "dark": "#6fd6b3", "$description": "Erfolg, abgeschlossen" },
    "warning": { "light": "#9a4500", "dark": "#ffb27a", "$description": "Warnung, Aufmerksamkeit" },
    "danger": { "light": "#b4232c", "dark": "#ff9aa0", "$description": "Fehler, destruktive Aktion" },
    "info": { "light": "#0b5cad", "dark": "#8cc4ff", "$description": "Neutrale Information" },
    "text": { "light": "#1c1b29", "dark": "#ecebf5", "$description": "Fließtext" },
    "subtle": { "light": "#5b5970", "dark": "#a9a7bd", "$description": "Sekundärtext, Hilfetexte" },
    "ink": { "light": "#000000", "dark": "#ecebf5", "$description": "Höchster Kontrast" },
    "surface": { "light": "#f7f6fb", "dark": "#121120", "$description": "Seitenhintergrund (Ebene 0)" },
    "light": { "light": "#ffffff", "dark": "#1b1a2c", "$description": "Komponentenfläche (Ebene 1)" },
    "overlay": { "light": "#ffffff", "dark": "#24233a", "$description": "Overlays, Dialoge (Ebene 2)" },
    "mute": { "light": "#efeef6", "dark": "#25243a", "$description": "Gedämpfte Fläche" },
    "mute-variant": { "light": "#c9c7d8", "dark": "#3f3d57", "$description": "Linien, Rahmen" },
    "edge": { "light": "transparent", "dark": "#4b4966", "$description": "Kante statt Schatten im Dark Mode" },
    "visited": { "light": "#6a2fb0", "dark": "#d3b4ff", "$description": "Besuchte Links" },
    "shadow": { "light": "rgb(28 23 80 / 0.14)", "dark": "transparent", "$description": "Schattenfarbe" },
    "backdrop": { "light": "rgb(18 17 32 / 0.35)", "dark": "rgb(0 0 0 / 0.6)", "$description": "Abdunklung hinter Modals" }
  },
  "font": {
    "family": { "value": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", Arial, sans-serif" },
    "family-mono": { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" },
    "size": { "value": "1rem" },
    "weight-regular": { "value": "400" },
    "weight-medium": { "value": "500" },
    "weight-bold": { "value": "650" }
  },
  "type-scale": {
    "xs": { "value": "0.75rem" },
    "sm": { "value": "0.875rem" },
    "md": { "value": "1rem" },
    "lg": { "value": "1.25rem" },
    "xl": { "value": "1.5rem" },
    "2xl": { "value": "2rem" },
    "3xl": { "value": "2.5rem" }
  },
  "space": {
    "base": { "value": "0.25rem", "$description": "4px-Raster, an KoliBri --kolibri-spacing übergeben" },
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4rem" }
  },
  "radius": {
    "sm": { "value": "6px" },
    "md": { "value": "10px" },
    "lg": { "value": "16px" },
    "pill": { "value": "999px" }
  },
  "border": {
    "width": { "value": "1px" }
  },
  "elevation": {
    "1": { "value": "0 1px 2px var(--fink-color-shadow), 0 0 0 1px var(--fink-color-edge)" },
    "2": { "value": "0 4px 12px var(--fink-color-shadow), 0 0 0 1px var(--fink-color-edge)" },
    "3": { "value": "0 12px 32px var(--fink-color-shadow), 0 0 0 1px var(--fink-color-edge)" }
  },
  "focus": {
    "color": { "value": "var(--fink-color-primary)", "$description": "Fokusring-Farbe; bei Porsche z. B. das dokumentierte ColorFocus statt der Primärfarbe" }
  },
  "motion": {
    "duration-fast": { "value": "120ms" },
    "duration-base": { "value": "200ms" },
    "easing": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "breakpoint": {
    "md": { "value": "768px" },
    "lg": { "value": "1024px" }
  }
}
