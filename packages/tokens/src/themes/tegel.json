{
	"$description": "Stil-Nachbau des Tegel Design Systems von Scania (Quelle: scania-digital-design-system/tegel, color/_tokens.scss und _scania-color-primitives.scss). Die Schrift Scania Sans ist lizenziert und wird durch Inter ersetzt.",
	"$label": "Tegel (Scania)",
	"$source": "https://github.com/scania-digital-design-system/tegel",
	"color": {
		"primary": {
			"light": "#0F3263",
			"dark": "#4A89F3",
			"$description": "cta → blue-700 / gespiegelte Skalenposition blue-300 für Dark"
		},
		"primary-variant": {
			"light": "#041E42",
			"dark": "#87AFE8",
			"$description": "blue-800 / blue-200, gespiegelte Skalenpositionen"
		},
		"secondary": {
			"light": "#EDEFF3",
			"dark": "#15181D",
			"$description": "grey-100 / grey-900"
		},
		"success": {
			"light": "#1DAB8B",
			"dark": "#1DAB8B",
			"$description": "positive; Dark-Variante nicht definiert"
		},
		"warning": {
			"light": "#F1C21B",
			"dark": "#F1C21B",
			"$description": "warning; Dark-Variante nicht definiert"
		},
		"danger": {
			"light": "#FF2340",
			"dark": "#FF2340",
			"$description": "negative; Dark-Variante nicht definiert"
		},
		"info": {
			"light": "#2A6ECF",
			"dark": "#87AFE8",
			"$description": "information → blue-400 / blue-200"
		},
		"text": {
			"light": "#0B0C0F",
