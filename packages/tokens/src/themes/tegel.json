		},
		"ink": {
			"light": "#000000",
			"dark": "#FFFFFF",
			"$description": "black-100 / white-100"
		},
		"surface": {
			"light": "#FFFFFF",
			"dark": "#0B0C0F",
			"$description": "grey-00 / grey-950"
		},
		"light": {
			"light": "#FFFFFF",
			"dark": "#15181D",
			"$description": "grey-00 / grey-900"
		},
		"overlay": {
			"light": "#FFFFFF",
			"dark": "#15181D",
			"$description": "grey-00 / grey-900"
		},
		"mute": {
			"light": "#F6F7F9",
			"dark": "#1C222B",
			"$description": "grey-50 / grey-850"
		},
		"mute-variant": {
			"light": "#D1D7E0",
			"dark": "#3A4554",
			"$description": "grey-200 / grey-700"
		},
		"edge": {
			"light": "transparent",
			"dark": "#3A4554",
