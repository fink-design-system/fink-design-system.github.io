{
	"$description": "Stil-Nachbau von KERN UX (Design-System Schleswig-Holstein, Quelle: @kern-ux/native 2.3.0, dist/kern.css Fallback-Werte). Die Schrift Fira Sans ist frei verfügbar und bleibt erhalten. KoliBri liefert zudem das fertige Paket @public-ui/theme-kern.",
	"$label": "KERN UX",
	"$source": "https://www.npmjs.com/package/@kern-ux/native",
	"color": {
		"primary": {
			"light": "#1A3DA5",
			"dark": "#1A3DA5",
			"$description": "kern-color-action-default; eine Dark-Variante ist nicht dokumentiert"
		},
		"primary-variant": {
			"light": "#1A3DA5",
			"dark": "#1A3DA5",
			"$description": "Hover/Active sind als shade-Tokens referenziert, ohne aufgelösten Wert in dieser Quelle"
		},
		"secondary": {
			"light": "#E0F4FC",
			"dark": "#171A2B",
			"$description": "feedback-info-background / Textton als dunkle Fläche"
		},
		"success": {
			"light": "#006B51",
			"dark": "#006B51",
			"$description": "kern-color-feedback-success; Dark-Variante nicht dokumentiert"
		},
		"warning": {
			"light": "#8A4F00",
			"dark": "#8A4F00",
			"$description": "kern-color-feedback-warning"
		},
		"danger": {
			"light": "#BD0F09",
			"dark": "#BD0F09",
			"$description": "kern-color-feedback-danger"
		},
		"info": {
			"light": "#006490",
			"dark": "#006490",
			"$description": "kern-color-feedback-info"
		},
		"text": {
			"light": "#171A2B",
			"dark": "#FFFFFF",
			"$description": "kern-color-layout-text-default"
		},
		"subtle": {
			"light": "#404565",
			"dark": "#A5AAC3",
			"$description": "text-muted / Border-Ton als dunkle Sekundärstufe"
		},
		"ink": {
			"light": "#000000",
			"dark": "#FFFFFF"
		},
		"surface": {
			"light": "#FFFFFF",
			"dark": "#171A2B",
			"$description": "layout-background-default; Dark-Modus bei KERN nicht dokumentiert"
		},
		"light": {
			"light": "#FFFFFF",
			"dark": "#171A2B",
			"$description": "layout-background-default"
		},
		"overlay": {
			"light": "#FFFFFF",
			"dark": "#171A2B",
			"$description": "layout-background-default"
		},
		"mute": {
			"light": "#FFFFFF",
			"dark": "#171A2B",
			"$description": "KERN kennt nur default und hued als Flächen; hued ohne aufgelösten Wert"
		},
		"mute-variant": {
			"light": "#A5AAC3",
			"dark": "#404565",
			"$description": "kern-color-layout-border"
		},
		"edge": {
			"light": "transparent",
			"dark": "#404565",
			"$description": "Kante statt Schatten im Dark Mode"
		},
		"visited": {
			"light": "#1A3DA5",
			"dark": "#1A3DA5",
			"$description": "Visited als eigenes Action-Token referenziert, ohne aufgelösten Wert"
		},
		"shadow": {
			"light": "rgb(23 26 43 / 0.14)",
			"dark": "transparent",
			"$description": "neutraler Schatten im Textton"
		},
		"backdrop": {
			"light": "rgb(23 26 43 / 0.35)",
			"dark": "rgb(0 0 0 / 0.6)",
			"$description": "aus dem Fink-Raster"
		},
		"focus": {
			"value": "#1A3DA5",
			"$description": "KERN setzt den Fokus als dreistufigen Box-Shadow auf Action-Tokens; Fink nutzt einen Fokusring"
		}
	},
	"radius": {
		"sm": {
			"value": "2px",
			"$description": "kern-metric-border-radius-small"
		},
		"md": {
			"value": "4px",
			"$description": "kern-metric-border-radius-default"
		},
		"lg": {
			"value": "8px",
			"$description": "kern-metric-border-radius-large"
		}
	},
	"font": {
		"family": {
			"value": "\"Fira Sans\", Arial, sans-serif",
			"$description": "frei verfügbar, im Original verankert; KoliBris theme-kern nutzt @fontsource/fira-sans"
		}
	}
}
