{
	"$description": "Stil-Nachbau des Baloise Design Systems (Quelle: @baloise/design-system-tokens 15.2.4, dist/tokens.css). Die Schriften BaloiseCreateHeadline/Text sind lizenziert und werden durch Inter ersetzt.",
	"$label": "Baloise Design System",
	"$source": "https://github.com/baloise/design-system",
	"color": {
		"primary": {
			"light": "#000D6E",
			"dark": "#B3B6D4",
			"$description": "primary-5 (blue-5); im Dunkel auf blue-2 aufgehellt (Text- und Buttonrolle ≥4,5:1)"
		},
		"primary-variant": {
			"light": "#000739",
			"dark": "#E5E7F0",
			"$description": "Hover: light blue-6, dark blue-1 (im Dunkel heller statt dunkler)"
		},
		"secondary": {
			"light": "#E5E7F0",
			"dark": "#000739",
			"$description": "blue-1 / blue-6 als getönte Fläche"
		},
		"success": {
			"light": "#168741",
			"dark": "#168741",
			"$description": "success-4; Dark-Variante nicht definiert"
		},
		"warning": {
			"light": "#FFBE19",
			"dark": "#FFBE19",
			"$description": "warning-4; Dark-Variante nicht definiert"
		},
		"danger": {
			"light": "#EA1800",
			"dark": "#ff8a96",
			"$description": "danger-4; im Dunkel auf abgeleitet #ff8a96 aufgehellt (dunkler Button-Text ≥4,5:1)"
		},
		"info": {
			"light": "#1C77D2",
			"dark": "#1C77D2",
			"$description": "info-4; Dark-Variante nicht definiert"
		},
		"text": {
			"light": "#000D6E",
			"dark": "#FFFFFF",
			"$description": "text-primary (primary-5) / Weiß"
		},
		"subtle": {
			"light": "#595959",
			"dark": "#B6B6B6",
			"$description": "text-grey (#747474) abgedunkelt (abgeleitet #595959) für ≥4,5:1 auf grey-1"
		},
		"ink": {
			"light": "#000000",
			"dark": "#FFFFFF",
			"$description": "text-black"
		},
		"surface": {
			"light": "#FFFFFF",
			"dark": "#000739",
			"$description": "Weiß / blue-6 als dunkle Basisfläche"
		},
		"light": {
			"light": "#FFFFFF",
			"dark": "#313131",
			"$description": "Komponentenfläche: Weiß / grey-6; --color-light ist zugleich Button-Text im Dunkel"
		},
		"overlay": {
			"light": "#FFFFFF",
			"dark": "#000D6E",
			"$description": "Weiß / blue-5"
		},
		"mute": {
			"light": "#FAFAFA",
			"dark": "#313131",
			"$description": "grey-1 / grey-6"
		},
		"mute-variant": {
			"light": "#E8E8E8",
			"dark": "#293485",
			"$description": "border-grey / blue-4 als dunkle Linienfarbe"
		},
		"edge": {
			"light": "transparent",
			"dark": "#293485",
			"$description": "Kante statt Schatten im Dark Mode"
		},
		"visited": {
			"light": "#1C77D2",
			"dark": "#1C77D2",
			"$description": "Baloise dokumentiert keine Visited-Stufe; Links folgen Info"
		},
		"shadow": {
			"light": "rgb(0 13 110 / 0.14)",
			"dark": "transparent",
			"$description": "neutraler Schatten im Blauton; Baloise definiert Schatten nicht in dieser Token-Datei"
		},
		"backdrop": {
			"light": "rgb(0 7 57 / 0.35)",
			"dark": "rgb(0 0 0 / 0.6)",
			"$description": "aus dem Fink-Raster"
		},
		"focus": {
			"value": "#000D6E",
			"$description": "Fokus folgt Primary"
		}
	},
	"radius": {
		"sm": {
			"value": "0.25rem",
			"$description": "bal-radius-normal"
		},
		"md": {
			"value": "0.25rem",
			"$description": "bal-radius-normal"
		},
		"lg": {
			"value": "0.75rem",
			"$description": "bal-radius-large"
		},
		"pill": {
			"value": "9999px",
			"$description": "bal-radius-rounded"
		}
	},
	"type-scale": {
		"lg": {
			"value": "1.125rem",
			"$description": "medium (Desktop)"
		},
		"2xl": {
			"value": "1.75rem",
			"$description": "xxx-large"
		},
		"3xl": {
			"value": "2rem",
			"$description": "xxxx-large (Basis)"
		}
	},
	"font": {
		"weight-medium": {
			"value": "700",
			"$description": "Baloise kennt 300/400/700; die mittlere Rolle ist 700"
		},
		"weight-bold": {
			"value": "700"
		}
	}
}
